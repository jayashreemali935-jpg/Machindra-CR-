<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Machindra CRM</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 font-sans">
    <div class="min-h-screen flex flex-col items-center justify-center p-6">
        <div class="bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center border border-gray-100">
            <div class="bg-blue-600 text-white w-16 h-16 mx-auto rounded-xl flex items-center justify-center text-2xl font-bold mb-4 shadow-md">MC</div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Machindra <span class="text-blue-600">CRM</span></h1>
            <p class="text-gray-600 mb-6">Lead & Project Management Dashboard for Global Business.</p>
            <div class="bg-blue-50 text-blue-700 p-4 rounded-xl text-sm font-medium">
                🚀 Status: Successfully Live on GitHub Pages!
            </div>
        </div>
    </div>
</body>
</html>
